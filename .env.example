APP_NAME=AI College
APP_VERSION=0.1.0
DEBUG=true
DATABASE_URL=sqlite:///./data/ai_college.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Development model for a CPU laptop; use a stronger local model on the college server.
OLLAMA_MODEL=qwen2.5:1.5b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT=120
LLM_MAX_INPUT_CHARACTERS=8000
LLM_SYSTEM_PROMPT="You are AI College Assistant, a helpful local general-purpose assistant. Answer normally and concisely. Do not invent facts about the college."
